# ==============================================================================
# AAYAM Backend — Production Environment Template (Render)
# ==============================================================================
# Set these variables in the Render Dashboard under:
# Dashboard > aayam-backend > Environment
# ==============================================================================

# Core Application Settings
ENV=production
APP_NAME=AAYAM Infrastructure Intelligence API
PORT=8000
HOST=0.0.0.0

# Database Configuration (Managed PostgreSQL)
# Render automatically injects this if linked to a Render PostgreSQL service.
# If connecting manually: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql://aayam:your_secure_password@dpg-xxxxxx.oregon-postgres.render.com/aayam_infra

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Authentication & Security
# Generate with: openssl rand -hex 32 (Must be 32+ characters in production)
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://aayam.vercel.app,https://your-custom-domain.com
# Regex to automatically permit all Vercel preview branch deployments
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# AI Decision Copilot — OpenRouter Provider
# Enter your OpenRouter API key (sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=https://aayam.vercel.app
OPENROUTER_APP_NAME=AAYAM Infrastructure Intelligence

# Persistent Storage (Optional: When Render Persistent Disk is attached)
# Default falls back gracefully to repository bundled data
DATA_DIR=/var/data
MEDIA_DIR=/var/data/media
EVIDENCE_DIR=/var/data/evidence

