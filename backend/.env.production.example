# ==============================================================================
# AAYAM Backend — Production Environment Template (Render Free + Supabase Free)
# ==============================================================================
# Configure these variables in your Render Dashboard:
# Dashboard > aayam-backend > Environment
# ==============================================================================

# Core Application Settings
ENV=production
APP_NAME=AAYAM Infrastructure Intelligence API
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. Database: Supabase PostgreSQL (Free Tier)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard > Project Settings > Database > Connection String
# Use Session pooler (port 5432) or Transaction pooler (port 6543):
# Example:
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Conservative connection pooling tuned for Supabase free limits
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 2. Storage: Supabase Storage (Free Tier)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Use your service_role secret key (or anon public key if buckets are public)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET_MEDIA=aayam-media
SUPABASE_STORAGE_BUCKET_EVIDENCE=aayam-evidence

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (Must be at least 32 characters in production)
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. CORS Origins (Frontend Domain)
# ------------------------------------------------------------------------------
# Strictly restricted to primary production domain
CORS_ORIGINS=https://aayam.vercel.app
# Optional regex: leave empty to disallow arbitrary preview domains
# CORS_ORIGIN_REGEX=

# ------------------------------------------------------------------------------
# 5. AI Copilot: OpenRouter Integration
# ------------------------------------------------------------------------------
# Your OpenRouter API Key (kept strictly on the backend)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=https://aayam.vercel.app
OPENROUTER_APP_NAME=AAYAM Infrastructure Intelligence
